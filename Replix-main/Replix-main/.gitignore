build/
dist-python/
electron/dist/
electron/node_modules/
*.spec
replix-server.spec

# ===== Python cache =====
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ===== OS / IDE =====
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ===== Logs / Temp =====
*.log
logs/
*.tmp
*.temp
.waylog/
