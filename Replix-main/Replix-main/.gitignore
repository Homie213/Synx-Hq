# ===== SECRETS — never commit =====
.env
.env.*
*.env
secrets/
*.pem
*.key
*.p12
*.pfx
cookies.txt
*cookies*.txt

# ===== Data — stays local =====
data/
*.db
*.db-shm
*.db-wal

